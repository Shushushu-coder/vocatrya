/// storageKey is a relative/logical key, never a fixed Windows absolute path.
model ResumeArtifact {
  id                     String @id @default(uuid())
  resumeVariantVersionId String

  kind       String
  format     String
  storageKey String
  fileName   String
  sha256     String
  byteSize   Int?

  createdAt DateTime @default(now())

  version           ResumeVariantVersion @relation(fields: [resumeVariantVersionId], references: [id], onDelete: Cascade)
  submittedAttempts ApplicationAttempt[] @relation("AttemptSubmittedResumeArtifact")

  @@index([resumeVariantVersionId])
}

/// Durable pre-invocation identity for the canonical resume import (M4).
/// The client mints `id` before the first POST and reuses it on transport
/// retries, so the same logical import always resolves to the same
/// attempt — and therefore the same Managed binding + operation identity.
/// state: PENDING (created) → RUNNING (lock persisted) → EXECUTED
/// (resultJson cached) | FAILED (execution failed; executionSeq bumped so
/// a later retry is a genuinely new operation) → CONFIRMED.
/// requestSha is a consistency guard only — never an operation key.
model ResumeImportAttempt {
  id     String @id
  userId String

  state        String @default("PENDING")
  executionSeq Int    @default(0)
  requestSha   String

  resolvedConnectionId String?
  resolvedModel        String?
  managedAiProvenance  String?

  /// Cached structured result — replayed to post-crash retries because
  /// the Hosted invocation ledger returns receipts, not payloads.
  resultJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// FAST_SCREENING requires resumeVariantVersionId = null;
/// DEEP_MATCH requires resumeVariantVersionId != null.
/// Enforced in the service layer, not by the database.
model MatchAnalysis {
  id                    String @id @default(uuid())
  userId                String
  jobOpportunityId      String
  jobDescriptionParseId String

  analysisType           String
  resumeVariantVersionId String?

  inputHash             String
  analysisSchemaVersion String
  provider              String?
  model                 String?
  promptVersion         String?
  status                String
  errorCode             String?
  isStale               Boolean   @default(false)
  staleReasonCodes      String?
  staleAt               DateTime?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Phase B: nullable AI connection lock. `model` above already carries the
  // resolved model provenance, so no resolvedModel synonym is added here.
  // Immutable historical snapshot; never hosted entitlement authority.
  managedAiProvenance String?
  resolvedConnectionId String?
  resolvedConnection   AIConnection? @relation(fields: [resolvedConnectionId], references: [id], onDelete: Restrict)

  user                    User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  jobOpportunity          JobOpportunity         @relation(fields: [jobOpportunityId], references: [id], onDelete: Restrict)
  jobDescriptionParse     JobDescriptionParse    @relation(fields: [jobDescriptionParseId], references: [id], onDelete: Restrict)
  resumeVariantVersion    ResumeVariantVersion?  @relation("MatchAnalysisResumeVersion", fields: [resumeVariantVersionId], references: [id], onDelete: Restrict)
  resumeVersionsFromMatch ResumeVariantVersion[] @relation("ResumeVersionSourceMatch")
  fastScreeningDetail     FastScreeningDetail?
  deepMatchDetail         DeepMatchDetail?
  evidenceLinks           MatchEvidenceLink[]

  @@index([jobOpportunityId, analysisType, isStale])
  @@index([userId, analysisType, isStale])
  @@index([resumeVariantVersionId])
}

model FastScreeningDetail {
  id               String   @id @default(uuid())
  matchAnalysisId  String   @unique
  verdict          String
  inputSnapshot    String
  hardRequirements String?
  coreMatch        String?
  preferenceMatch  String?
  reasons          String?
  createdAt        DateTime @default(now())

  matchAnalysis MatchAnalysis @relation(fields: [matchAnalysisId], references: [id], onDelete: Cascade)
}

model DeepMatchDetail {
  id                              String   @id @default(uuid())
  matchAnalysisId                 String   @unique
  overallSummary                  String
  overallScore                    Int?
  hardRequirements                String?
  responsibilityAlignment         String?
  experienceRelevance             String?
  skillCoverage                   String?
  educationExperienceFit          String?
  strengths                       String?
  gaps                            String?
  resumeOptimizationOpportunities String?
  nonFixableGaps                  String?
  createdAt                       DateTime @default(now())

  matchAnalysis MatchAnalysis @relation(fields: [matchAnalysisId], references: [id], onDelete: Cascade)
}

model MatchEvidenceLink {
  id              String @id @default(uuid())
  matchAnalysisId String

  requirementKey          String
  requirementTextSnapshot String
  careerEvidenceId        String?
  resumeExpressionId      String?
  judgement               String
  evidenceContentSnapshot String?
  evidenceHashSnapshot    String?

  createdAt DateTime @default(now())

  matchAnalysis    MatchAnalysis     @relation(fields: [matchAnalysisId], references: [id], onDelete: Cascade)
  careerEvidence   CareerEvidence?   @relation(fields: [careerEvidenceId], references: [id], onDelete: Restrict)
  resumeExpression ResumeExpression? @relation(fields: [resumeExpressionId], references: [id], onDelete: Restrict)

  @@index([matchAnalysisId])
}

model LegacyMigrationMap {
  id               String  @id @default(uuid())
  userId           String
  legacyEntityType String
  legacyEntityId   String
  targetEntityType String
  targetEntityId   String
  migrationVersion String
  mappingReason    String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, legacyEntityType, legacyEntityId, targetEntityType, targetEntityId])
  @@index([targetEntityType, targetEntityId])
}

model DataMigrationRun {
  id          String    @id @default(uuid())
  userId      String?
  version     String
  mode        String
  status      String
  counts      String?
  errorCode   String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, startedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 3A Interview transplant — Interview-owned persistence graph only.
// Source: InterviewDx port prisma/schema.prisma (standalone, verified) via
// prisma/transplant/interview-models.prisma fragment + interview-host-relations.
// Enums stay String; allowed values enforced by manual CHECK SQL in migration.
// No services, knowledge, preset data, UI/API transplanted here.
// ---------------------------------------------------------------------------

model QuestionBank {
  id        String   @id @default(uuid())
  bankKey   String
  version   String
  title     String
  locale    String   @default("zh")
  kind      String   @default("SAMPLE_FIXTURE")
  createdAt DateTime @default(now())

  items QuestionBankItem[]

  @@unique([bankKey, version])
}

model QuestionBankItem {
  id           String   @id @default(uuid())
  bankId       String
  questionId   String
  displayOrder Int
  createdAt    DateTime @default(now())

  bank     QuestionBank @relation(fields: [bankId], references: [id], onDelete: Restrict)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([bankId, questionId])
  @@unique([bankId, displayOrder])
}

model InterviewSession {
  id                        String    @id @default(uuid())
  userId                    String
  // status: DRAFT | IN_PROGRESS | COACHING | COMPLETED | ARCHIVED
  status                    String    @default("DRAFT")
  // coachingMode: PRACTICE | MOCK
  coachingMode              String
  // feedbackReleasePolicy: IMMEDIATE | ON_SESSION_COMPLETE
  feedbackReleasePolicy     String
  feedbackReleasedAt        DateTime?
  startedAt                 DateTime?
  completedAt               DateTime?
  archivedAt                DateTime?
  statusBeforeArchive       String?
  knowledgeBaseVersion      String
  currentQuestionInstanceId String?
  jobOpportunityId          String?
  jobDescriptionVersionId   String?
  createdVia                String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Phase B: nullable AI lock captured at resolution time. NO_GUESS_BACKFILL:
  // existing rows keep NULL and rely on provider/model provenance alone.
  // Immutable historical snapshot; never hosted entitlement authority.
  managedAiProvenance String?
  resolvedConnectionId String?
  resolvedModel        String?
  resolvedConnection   AIConnection? @relation(fields: [resolvedConnectionId], references: [id], onDelete: Restrict)

  user                    User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  jobOpportunity          JobOpportunity?            @relation(fields: [jobOpportunityId], references: [id], onDelete: Restrict)
  jobDescriptionVersion   JobDescriptionVersion?     @relation(fields: [jobDescriptionVersionId, jobOpportunityId], references: [id, jobOpportunityId], onDelete: Restrict)
  currentQuestionInstance QuestionInstance?          @relation("SessionCurrentQuestion", fields: [currentQuestionInstanceId], references: [id], onDelete: Restrict)
  questionInstances       QuestionInstance[]         @relation("SessionQuestions")
  answerAttempts          AnswerAttempt[]
  inputArtifacts          AnswerInputArtifact[]
  transcripts             Transcript[]
  feedbackGenerations     FeedbackGeneration[]
  feedbackItems           FeedbackItem[]
  summaryGenerations      SessionSummaryGeneration[]
  coachingConversation    CoachingConversation?
  dialogueTurns           DialogueTurn[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model QuestionInstance {
  id                      String   @id @default(uuid())
  sessionId               String
  sourceQuestionId        String?
  displayOrder            Int
  displayedText           String
  // sourceKind: USER_PROVIDED | QUESTION_BANK | AI_GENERATED | TEMPLATE
  sourceKind              String
  category                String?
  sourceMetadata          String?
  referenceAnswerSnapshot String?
  // status: PENDING | IN_PROGRESS | ANSWERED | SKIPPED
  status                  String   @default("PENDING")
  createdAt               DateTime @default(now())

  session        InterviewSession   @relation("SessionQuestions", fields: [sessionId], references: [id], onDelete: Restrict)
  sourceQuestion Question?          @relation(fields: [sourceQuestionId], references: [id], onDelete: Restrict)
  currentFor     InterviewSession[] @relation("SessionCurrentQuestion")
  answerAttempts AnswerAttempt[]
  dialogueTurns  DialogueTurn[]

  @@unique([sessionId, displayOrder])
  @@unique([id, sessionId])
}

model AnswerAttempt {
  id                 String    @id @default(uuid())
  questionInstanceId String
  sessionId          String
  attemptNumber      Int
  // inputType: TEXT | AUDIO
  inputType          String
  // status: STARTED | SUBMITTED | COMPLETED | FAILED | DISCARDED
  status             String    @default("STARTED")
  startedAt          DateTime?
  submittedAt        DateTime?
  completedAt        DateTime?
  durationMs         Int?
  activeRevisionId   String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())

  session             InterviewSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  questionInstance    QuestionInstance      @relation(fields: [questionInstanceId, sessionId], references: [id, sessionId], onDelete: Restrict)
  activeRevision      TranscriptRevision?   @relation("AttemptActiveRevision", fields: [activeRevisionId, id], references: [id, answerAttemptId], onDelete: Restrict)
  inputArtifacts      AnswerInputArtifact[]
  transcripts         Transcript[]
  revisions           TranscriptRevision[]  @relation("AttemptRevisions")
  feedbackGenerations FeedbackGeneration[]
  dialogueTurns       DialogueTurn[]

  @@unique([questionInstanceId, attemptNumber])
  @@unique([id, sessionId])
  @@unique([id, questionInstanceId, sessionId])
  @@index([sessionId, createdAt])
}

model AnswerInputArtifact {
  id              String   @id @default(uuid())
  answerAttemptId String
  sessionId       String
  // inputType: TEXT | AUDIO
  inputType       String
  // role: SOURCE | NORMALIZED
  role            String
  filePath        String?
  fileFormat      String?
  durationSeconds Float?
  fileSizeBytes   Int?
  textContent     String?
  createdAt       DateTime @default(now())

  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  attempt     AnswerAttempt    @relation(fields: [answerAttemptId, sessionId], references: [id, sessionId], onDelete: Restrict)
  transcripts Transcript[]

  @@index([answerAttemptId])
}

model Transcript {
  id               String   @id @default(uuid())
  sessionId        String
  answerAttemptId  String
  sourceArtifactId String?
  fullText         String
  segments         String   @default("[]")
  asrModel         String?
  asrStatus        String?
  errorMessage     String?
  createdAt        DateTime @default(now())

  session        InterviewSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  attempt        AnswerAttempt        @relation(fields: [answerAttemptId], references: [id], onDelete: Restrict)
  sourceArtifact AnswerInputArtifact? @relation(fields: [sourceArtifactId], references: [id], onDelete: Restrict)
  revisions      TranscriptRevision[]
  feedbackItems  FeedbackItem[]

  @@index([answerAttemptId])
}

model TranscriptRevision {
  id              String   @id @default(uuid())
  transcriptId    String
  answerAttemptId String
  revisionNumber  Int
  // revisionKind: ORIGINAL_ASR | ORIGINAL_TEXT | USER_CORRECTED
  revisionKind    String
  fullText        String
  segments        String?
  // alignmentStatus: PRESERVED | PARTIAL | DROPPED | NOT_APPLICABLE
  alignmentStatus String
  contentHash     String
  createdByUserId String?
  createdVia      String?
  createdAt       DateTime @default(now())

  transcript          Transcript           @relation(fields: [transcriptId], references: [id], onDelete: Restrict)
  attempt             AnswerAttempt        @relation("AttemptRevisions", fields: [answerAttemptId], references: [id], onDelete: Restrict)
  createdByUser       User?                @relation("RevisionAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activeFor           AnswerAttempt[]      @relation("AttemptActiveRevision")
  feedbackGenerations FeedbackGeneration[]

  @@unique([transcriptId, revisionNumber])
  @@unique([id, answerAttemptId])
}

model FeedbackGeneration {
  id                   String    @id @default(uuid())
  answerAttemptId      String
  questionInstanceId   String
  sessionId            String
  versionNumber        Int
  isCurrent            Boolean   @default(false)
  // status: PENDING | SUCCEEDED | FAILED | CANCELLED
  status               String    @default("PENDING")
  inputRevisionId      String
  inputContentHash     String
  model                String?
  provider             String?
  promptVersion        String?
  knowledgeBaseVersion String?
  failureCode          String?
  failureMessage       String?
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  session       InterviewSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  attempt       AnswerAttempt         @relation(fields: [answerAttemptId, questionInstanceId, sessionId], references: [id, questionInstanceId, sessionId], onDelete: Restrict)
  inputRevision TranscriptRevision    @relation(fields: [inputRevisionId, answerAttemptId], references: [id, answerAttemptId], onDelete: Restrict)
  items         FeedbackItem[]
  summaryInputs SessionSummaryInput[]

  @@unique([answerAttemptId, versionNumber])
  @@unique([id, answerAttemptId])
  @@unique([id, questionInstanceId, sessionId])
}

model FeedbackItem {
  id           String   @id @default(uuid())
  sessionId    String
  transcriptId String
  generationId String
  itemOrder    Int
  problemLabel String
  evidence     String
  explanation  String
  suggestion   String
  createdAt    DateTime @default(now())

  session       InterviewSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  transcript    Transcript         @relation(fields: [transcriptId], references: [id], onDelete: Restrict)
  generation    FeedbackGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  dialogueTurns DialogueTurn[]

  @@unique([id, sessionId])
  @@index([generationId, itemOrder])
}

model SessionSummaryGeneration {
  id                   String    @id @default(uuid())
  sessionId            String
  versionNumber        Int
  // status: PENDING | SUCCEEDED | FAILED | CANCELLED
  status               String    @default("PENDING")
  isCurrent            Boolean   @default(false)
  bodyText             String?
  structuredPayload    String?
  inputHash            String
  model                String?
  provider             String?
  promptVersion        String?
  knowledgeBaseVersion String?
  failureCode          String?
  failureMessage       String?
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  session       InterviewSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  inputs        SessionSummaryInput[]
  dialogueTurns DialogueTurn[]

  @@unique([sessionId, versionNumber])
  @@unique([id, sessionId])
}

model SessionSummaryInput {
  id                   String   @id @default(uuid())
  summaryGenerationId  String
  sessionId            String
  questionInstanceId   String
  feedbackGenerationId String
  inputOrder           Int
  createdAt            DateTime @default(now())

  summary  SessionSummaryGeneration @relation(fields: [summaryGenerationId, sessionId], references: [id, sessionId], onDelete: Restrict)
  feedback FeedbackGeneration       @relation(fields: [feedbackGenerationId, questionInstanceId, sessionId], references: [id, questionInstanceId, sessionId], onDelete: Restrict)

  @@unique([summaryGenerationId, inputOrder])
  @@unique([summaryGenerationId, questionInstanceId])
}

model CoachingConversation {
  id        String    @id @default(uuid())
  sessionId String    @unique
  // status: OPEN | CLOSED
  status    String    @default("OPEN")
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  turns   DialogueTurn[]

  @@unique([id, sessionId])
}

model DialogueTurn {
  id                       String   @id @default(uuid())
  sessionId                String
  conversationId           String
  turnNumber               Int
  userText                 String
  entryMode                String
  assistantReply           String   @default("")
  replyModel               String?
  replyPromptVersion       String?
  contextSnapshot          String?
  // targetType: SESSION | QUESTION_INSTANCE | ANSWER_ATTEMPT | FEEDBACK_ITEM | SESSION_SUMMARY
  targetType               String
  questionInstanceId       String?
  answerAttemptId          String?
  commercialFeedbackItemId String?
  summaryGenerationId      String?
  createdAt                DateTime @default(now())

  session          InterviewSession          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  conversation     CoachingConversation      @relation(fields: [conversationId, sessionId], references: [id, sessionId], onDelete: Restrict)
  questionInstance QuestionInstance?         @relation(fields: [questionInstanceId, sessionId], references: [id, sessionId], onDelete: Restrict)
  answerAttempt    AnswerAttempt?            @relation(fields: [answerAttemptId, sessionId], references: [id, sessionId], onDelete: Restrict)
  feedbackItem     FeedbackItem?             @relation(fields: [commercialFeedbackItemId, sessionId], references: [id, sessionId], onDelete: Restrict)
  summary          SessionSummaryGeneration? @relation(fields: [summaryGenerationId, sessionId], references: [id, sessionId], onDelete: Restrict)

  @@unique([sessionId, turnNumber])
}

/// Phase B account-login foundation. One row per (user, external account
/// connection); multiple rows per provider are allowed so multi-account is
/// expressible. provider/authType/backendKind/status are plain Strings on
/// purpose — the sets evolve and are validated by the service/runtime
/// registry (src/lib/ai/connections.ts), never by SQLite CHECK constraints
/// that are expensive to change. accountIdentity is display-only and is
/// intentionally NOT unique: it is not guaranteed immutable, provider-wide
/// unique, or organization-independent; duplicate-account detection is a
/// provider-aware service concern. credentialRef is an opaque future
/// API_KEY seam and runtimeProfileRef an opaque runtime profile ref —
/// neither ever stores tokens, absolute paths, or model names.
/// providerMetadata is a non-secret JSON string (secret-key guard in
/// src/lib/ai/connections.ts). archive-not-delete: every inbound reference
/// is onDelete: Restrict, so a connection still referenced by assignments
/// or resolved locks cannot be removed, only archived.
model AIConnection {
  id                String    @id @default(uuid())
  userId            String
  provider          String
  authType          String    @default("ACCOUNT_LOGIN")
  backendKind       String
  displayName       String
  accountIdentity   String?
  status            String    @default("CONNECTED")
  credentialRef     String?
  runtimeProfileRef String?
  providerMetadata  String?
  lastVerifiedAt    DateTime?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessAssignments   AIBusinessAssignment[]
  interviewSessions     InterviewSession[]
  matchAnalyses         MatchAnalysis[]
  jobDescriptionParses  JobDescriptionParse[]
  resumeVariantVersions ResumeVariantVersion[]
  automationRuns        AutomationRun[]

  // Raw migration partial UNIQUE(userId) for active VOCATRYA/MANAGED_GATEWAY/MANAGED.
  // See 20261008000000_add_managed_ai_core_contracts.
  @@index([userId])
  @@index([userId, provider])
  @@index([userId, archivedAt])
}

/// (userId, purpose) pins which AIConnection + model a business surface
/// resolves to; GLOBAL_DEFAULT is the fallback purpose. Service-layer
/// invariants (not enforceable here): assignment.userId ===
/// connection.userId, and the referenced connection is not archived.
model AIBusinessAssignment {
  id           String   @id @default(uuid())
  userId       String
  purpose      String
  connectionId String
  model        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  connection AIConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([userId, purpose])
  @@index([connectionId])
}
