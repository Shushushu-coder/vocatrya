// ---------------------------------------------------------------------------
// Phase 3A Interview transplant — Interview-owned persistence graph only.
// Source: InterviewDx port prisma/schema.prisma (standalone, verified) via
// prisma/transplant/interview-models.prisma fragment + interview-host-relations.
// Enums stay String; allowed values enforced by manual CHECK SQL in migration.
// No services, knowledge, preset data, UI/API transplanted here.
// ---------------------------------------------------------------------------

model QuestionBank {
  id        String   @id @default(uuid())
  bankKey   String
  version   String
  title     String
  locale    String   @default("zh")
  kind      String   @default("SAMPLE_FIXTURE")
  createdAt DateTime @default(now())

  items QuestionBankItem[]

  @@unique([bankKey, version])
}

model QuestionBankItem {
  id           String   @id @default(uuid())
  bankId       String
  questionId   String
  displayOrder Int
  createdAt    DateTime @default(now())

  bank     QuestionBank @relation(fields: [bankId], references: [id], onDelete: Restrict)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([bankId, questionId])
  @@unique([bankId, displayOrder])
}

model InterviewSession {
  id                        String    @id @default(uuid())
  userId                    String
  // status: DRAFT | IN_PROGRESS | COACHING | COMPLETED | ARCHIVED
  status                    String    @default("DRAFT")
  // coachingMode: PRACTICE | MOCK
  coachingMode              String
  // feedbackReleasePolicy: IMMEDIATE | ON_SESSION_COMPLETE
  feedbackReleasePolicy     String
  feedbackReleasedAt        DateTime?
  startedAt                 DateTime?
  completedAt               DateTime?
  archivedAt                DateTime?
  statusBeforeArchive       String?
  knowledgeBaseVersion      String
  currentQuestionInstanceId String?
  jobOpportunityId          String?
  jobDescriptionVersionId   String?
  createdVia                String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Phase B: nullable AI lock captured at resolution time. NO_GUESS_BACKFILL:
  // existing rows keep NULL and rely on provider/model provenance alone.
  // Immutable historical snapshot; never hosted entitlement authority.
  managedAiProvenance String?
  resolvedConnectionId String?
  resolvedModel        String?
  resolvedConnection   AIConnection? @relation(fields: [resolvedConnectionId], references: [id], onDelete: Restrict)

  // Interview prep goal binding: one session serves at most one goal and a
  // goal at most one session. Written inside session creation; restored as
  // a nullable pointer so a missing goal degrades to unbound, never blocks.
  interviewPrepGoalId     String?                  @unique
  interviewPrepGoal     InterviewPrepGoal?       @relation(fields: [interviewPrepGoalId], references: [id], onDelete: SetNull)
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  jobOpportunity          JobOpportunity?            @relation(fields: [jobOpportunityId], references: [id], onDelete: Restrict)
  jobDescriptionVersion   JobDescriptionVersion?     @relation(fields: [jobDescriptionVersionId, jobOpportunityId], references: [id, jobOpportunityId], onDelete: Restrict)
  currentQuestionInstance QuestionInstance?          @relation("SessionCurrentQuestion", fields: [currentQuestionInstanceId], references: [id], onDelete: Restrict)
  questionInstances       QuestionInstance[]         @relation("SessionQuestions")
  answerAttempts          AnswerAttempt[]
  inputArtifacts          AnswerInputArtifact[]
  transcripts             Transcript[]
  feedbackGenerations     FeedbackGeneration[]
  feedbackItems           FeedbackItem[]
  summaryGenerations      SessionSummaryGeneration[]
  coachingConversation    CoachingConversation?
  dialogueTurns           DialogueTurn[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

/// User-owned interview preparation goal for one job opportunity.
/// Business state (backed up), not a runtime ledger: the goal pins the JD
/// version it prepares against, binds at most one InterviewSession through
/// InterviewSession.interviewPrepGoalId, and carries a deterministic
/// structured handoff snapshot (handoffJson) that any read can rebuild from
/// the bound business records. `liveSlot` = jobOpportunityId while the goal
/// is ACTIVE or PAUSED, enforcing at most one live goal per (user, job).
model InterviewPrepGoal {
  id            String @id @default(uuid())
  userId        String
  jobOpportunityId String
  pinnedJobDescriptionVersionId String
  // Content hash snapshot of the pinned JD version, so material drift can
  // still be reported honestly if the version row is gone.
  pinnedJdContentHash String

  // status: ACTIVE | PAUSED | COMPLETED | ENDED
  status        String @default("ACTIVE")
  // Optimistic-concurrency counter; every lifecycle mutation bumps it and
  // callers pass the last seen revision as a CAS guard.
  revision      Int @default(0)

  // Stable create-request dedupe identity (same semantics as HarnessTask).
  requestKey    String
  // = jobOpportunityId while status is ACTIVE or PAUSED; NULL on COMPLETED/ENDED.
  liveSlot      String?

  // Deterministic structured handoff snapshot (schemaVersion'd JSON):
  // verified progress, blockers and the next allowed business action.
  handoffJson         String?
  handoffGoalRevision Int?
  handoffVerifiedAt   DateTime?

  pausedAt    DateTime?
  completedAt DateTime?
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  jobOpportunity  JobOpportunity       @relation(fields: [jobOpportunityId], references: [id], onDelete: Restrict)
  pinnedJdVersion JobDescriptionVersion @relation(fields: [pinnedJobDescriptionVersionId], references: [id], onDelete: Restrict)
  sessions        InterviewSession[]
  agentTasks      AgentTask[]

  @@unique([userId, requestKey])
  @@unique([userId, liveSlot])
  @@index([userId, jobOpportunityId])
}

model QuestionInstance {
  id                      String   @id @default(uuid())
  sessionId               String
  sourceQuestionId        String?
  displayOrder            Int
  displayedText           String
  // sourceKind: USER_PROVIDED | QUESTION_BANK | AI_GENERATED | TEMPLATE
  sourceKind              String
  category                String?
  sourceMetadata          String?
  referenceAnswerSnapshot String?
  // status: PENDING | IN_PROGRESS | ANSWERED | SKIPPED
  status                  String   @default("PENDING")
  createdAt               DateTime @default(now())

  session        InterviewSession   @relation("SessionQuestions", fields: [sessionId], references: [id], onDelete: Restrict)
  sourceQuestion Question?          @relation(fields: [sourceQuestionId], references: [id], onDelete: Restrict)
  currentFor     InterviewSession[] @relation("SessionCurrentQuestion")
  answerAttempts AnswerAttempt[]
  dialogueTurns  DialogueTurn[]

  @@unique([sessionId, displayOrder])
  @@unique([id, sessionId])
}

model AnswerAttempt {
  id                 String    @id @default(uuid())
  questionInstanceId String
  sessionId          String
  attemptNumber      Int
  // inputType: TEXT | AUDIO
  inputType          String
  // status: STARTED | SUBMITTED | COMPLETED | FAILED | DISCARDED
  status             String    @default("STARTED")
  startedAt          DateTime?
  submittedAt        DateTime?
  completedAt        DateTime?
  durationMs         Int?
  activeRevisionId   String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())

  session             InterviewSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  questionInstance    QuestionInstance      @relation(fields: [questionInstanceId, sessionId], references: [id, sessionId], onDelete: Restrict)
  activeRevision      TranscriptRevision?   @relation("AttemptActiveRevision", fields: [activeRevisionId, id], references: [id, answerAttemptId], onDelete: Restrict)
  inputArtifacts      AnswerInputArtifact[]
  transcripts         Transcript[]
  revisions           TranscriptRevision[]  @relation("AttemptRevisions")
  feedbackGenerations FeedbackGeneration[]
  dialogueTurns       DialogueTurn[]

  @@unique([questionInstanceId, attemptNumber])
  @@unique([id, sessionId])
  @@unique([id, questionInstanceId, sessionId])
  @@index([sessionId, createdAt])
}

model AnswerInputArtifact {
  id              String   @id @default(uuid())
  answerAttemptId String
  sessionId       String
  // inputType: TEXT | AUDIO
  inputType       String
  // role: SOURCE | NORMALIZED
  role            String
  filePath        String?
  fileFormat      String?
  durationSeconds Float?
  fileSizeBytes   Int?
  textContent     String?
  createdAt       DateTime @default(now())

  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  attempt     AnswerAttempt    @relation(fields: [answerAttemptId, sessionId], references: [id, sessionId], onDelete: Restrict)
  transcripts Transcript[]

  @@index([answerAttemptId])
}

model Transcript {
  id               String   @id @default(uuid())
  sessionId        String
  answerAttemptId  String
  sourceArtifactId String?
  fullText         String
  segments         String   @default("[]")
  asrModel         String?
  asrStatus        String?
  errorMessage     String?
  createdAt        DateTime @default(now())

  session        InterviewSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  attempt        AnswerAttempt        @relation(fields: [answerAttemptId], references: [id], onDelete: Restrict)
  sourceArtifact AnswerInputArtifact? @relation(fields: [sourceArtifactId], references: [id], onDelete: Restrict)
  revisions      TranscriptRevision[]
  feedbackItems  FeedbackItem[]

  @@index([answerAttemptId])
}

model TranscriptRevision {
  id              String   @id @default(uuid())
  transcriptId    String
  answerAttemptId String
  revisionNumber  Int
  // revisionKind: ORIGINAL_ASR | ORIGINAL_TEXT | USER_CORRECTED
  revisionKind    String
  fullText        String
  segments        String?
  // alignmentStatus: PRESERVED | PARTIAL | DROPPED | NOT_APPLICABLE
  alignmentStatus String
  contentHash     String
  createdByUserId String?
  createdVia      String?
  createdAt       DateTime @default(now())

  transcript          Transcript           @relation(fields: [transcriptId], references: [id], onDelete: Restrict)
  attempt             AnswerAttempt        @relation("AttemptRevisions", fields: [answerAttemptId], references: [id], onDelete: Restrict)
  createdByUser       User?                @relation("RevisionAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activeFor           AnswerAttempt[]      @relation("AttemptActiveRevision")
  feedbackGenerations FeedbackGeneration[]

  @@unique([transcriptId, revisionNumber])
  @@unique([id, answerAttemptId])
}

model FeedbackGeneration {
  id                   String    @id @default(uuid())
  answerAttemptId      String
  questionInstanceId   String
  sessionId            String
  versionNumber        Int
  isCurrent            Boolean   @default(false)
  // status: PENDING | SUCCEEDED | FAILED | CANCELLED
  status               String    @default("PENDING")
  inputRevisionId      String
  inputContentHash     String
  model                String?
  provider             String?
  promptVersion        String?
  knowledgeBaseVersion String?
  failureCode          String?
  failureMessage       String?
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  session       InterviewSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  attempt       AnswerAttempt         @relation(fields: [answerAttemptId, questionInstanceId, sessionId], references: [id, questionInstanceId, sessionId], onDelete: Restrict)
  inputRevision TranscriptRevision    @relation(fields: [inputRevisionId, answerAttemptId], references: [id, answerAttemptId], onDelete: Restrict)
  items         FeedbackItem[]
  summaryInputs SessionSummaryInput[]

  @@unique([answerAttemptId, versionNumber])
  @@unique([id, answerAttemptId])
  @@unique([id, questionInstanceId, sessionId])
}

model FeedbackItem {
  id           String   @id @default(uuid())
  sessionId    String
  transcriptId String
  generationId String
  itemOrder    Int
  problemLabel String
  evidence     String
  explanation  String
  suggestion   String
  createdAt    DateTime @default(now())

  session       InterviewSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  transcript    Transcript         @relation(fields: [transcriptId], references: [id], onDelete: Restrict)
  generation    FeedbackGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  dialogueTurns DialogueTurn[]

  @@unique([id, sessionId])
  @@index([generationId, itemOrder])
}

model SessionSummaryGeneration {
  id                   String    @id @default(uuid())
  sessionId            String
  versionNumber        Int
  // status: PENDING | SUCCEEDED | FAILED | CANCELLED
  status               String    @default("PENDING")
  isCurrent            Boolean   @default(false)
  bodyText             String?
  structuredPayload    String?
  inputHash            String
  model                String?
  provider             String?
  promptVersion        String?
  knowledgeBaseVersion String?
  failureCode          String?
  failureMessage       String?
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  session       InterviewSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  inputs        SessionSummaryInput[]
  dialogueTurns DialogueTurn[]

  @@unique([sessionId, versionNumber])
  @@unique([id, sessionId])
}

model SessionSummaryInput {
  id                   String   @id @default(uuid())
  summaryGenerationId  String
  sessionId            String
  questionInstanceId   String
  feedbackGenerationId String
  inputOrder           Int
  createdAt            DateTime @default(now())

  summary  SessionSummaryGeneration @relation(fields: [summaryGenerationId, sessionId], references: [id, sessionId], onDelete: Restrict)
  feedback FeedbackGeneration       @relation(fields: [feedbackGenerationId, questionInstanceId, sessionId], references: [id, questionInstanceId, sessionId], onDelete: Restrict)

  @@unique([summaryGenerationId, inputOrder])
  @@unique([summaryGenerationId, questionInstanceId])
}

model CoachingConversation {
  id        String    @id @default(uuid())
  sessionId String    @unique
  // status: OPEN | CLOSED
  status    String    @default("OPEN")
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  turns   DialogueTurn[]

  @@unique([id, sessionId])
}

model DialogueTurn {
  id                       String   @id @default(uuid())
  sessionId                String
  conversationId           String
  turnNumber               Int
  userText                 String
  entryMode                String
  assistantReply           String   @default("")
  replyModel               String?
  replyPromptVersion       String?
  contextSnapshot          String?
  // targetType: SESSION | QUESTION_INSTANCE | ANSWER_ATTEMPT | FEEDBACK_ITEM | SESSION_SUMMARY
  targetType               String
  questionInstanceId       String?
  answerAttemptId          String?
  commercialFeedbackItemId String?
  summaryGenerationId      String?
  createdAt                DateTime @default(now())

  session          InterviewSession          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  conversation     CoachingConversation      @relation(fields: [conversationId, sessionId], references: [id, sessionId], onDelete: Restrict)
  questionInstance QuestionInstance?         @relation(fields: [questionInstanceId, sessionId], references: [id, sessionId], onDelete: Restrict)
  answerAttempt    AnswerAttempt?            @relation(fields: [answerAttemptId, sessionId], references: [id, sessionId], onDelete: Restrict)
  feedbackItem     FeedbackItem?             @relation(fields: [commercialFeedbackItemId, sessionId], references: [id, sessionId], onDelete: Restrict)
  summary          SessionSummaryGeneration? @relation(fields: [summaryGenerationId, sessionId], references: [id, sessionId], onDelete: Restrict)

  @@unique([sessionId, turnNumber])
}

/// Phase B account-login foundation. One row per (user, external account
/// connection); multiple rows per provider are allowed so multi-account is
/// expressible. provider/authType/backendKind/status are plain Strings on
/// purpose — the sets evolve and are validated by the service/runtime
/// registry (src/lib/ai/connections.ts), never by SQLite CHECK constraints
/// that are expensive to change. accountIdentity is display-only and is
/// intentionally NOT unique: it is not guaranteed immutable, provider-wide
/// unique, or organization-independent; duplicate-account detection is a
/// provider-aware service concern. credentialRef is an opaque future
/// API_KEY seam and runtimeProfileRef an opaque runtime profile ref —
/// neither ever stores tokens, absolute paths, or model names.
/// providerMetadata is a non-secret JSON string (secret-key guard in
/// src/lib/ai/connections.ts). archive-not-delete: every inbound reference
/// is onDelete: Restrict, so a connection still referenced by assignments
/// or resolved locks cannot be removed, only archived.
model AIConnection {
  id                String    @id @default(uuid())
  userId            String
  provider          String
  authType          String    @default("ACCOUNT_LOGIN")
  backendKind       String
  displayName       String
  accountIdentity   String?
  status            String    @default("CONNECTED")
  credentialRef     String?
  runtimeProfileRef String?
  providerMetadata  String?
  lastVerifiedAt    DateTime?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessAssignments   AIBusinessAssignment[]
  interviewSessions     InterviewSession[]
  matchAnalyses         MatchAnalysis[]
  jobDescriptionParses  JobDescriptionParse[]
  resumeVariantVersions ResumeVariantVersion[]
  automationRuns        AutomationRun[]

  // Raw migration partial UNIQUE(userId) for active VOCATRYA/MANAGED_GATEWAY/MANAGED.
  // See 20261008000000_add_managed_ai_core_contracts.
  @@index([userId])
  @@index([userId, provider])
  @@index([userId, archivedAt])
}

/// (userId, purpose) pins which AIConnection + model a business surface
/// resolves to; GLOBAL_DEFAULT is the fallback purpose. Service-layer
/// invariants (not enforceable here): assignment.userId ===
/// connection.userId, and the referenced connection is not archived.
model AIBusinessAssignment {
  id           String   @id @default(uuid())
  userId       String
  purpose      String
  connectionId String
  model        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  connection AIConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([userId, purpose])
  @@index([connectionId])
}

// Device-local native thread pointer. Never exported or restored.
model NativeConversationBinding {
  conversationId String @id
  userId String
  connectionId String
  model String
  runtimeVersion String
  runtimeProfileRef String
  configHash String
  threadId String
  promptHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([userId, connectionId])
}

/// Agent long-task ledger (job-search sprint). One AgentTask spans many
/// ChatConversation sessions; each session is a disposable Pilot-role
/// conversation linked through ChatConversation.agentTaskId. Domain entities
/// (JobOpportunity, InterviewPrepGoal) are pointers, never copies.
/// First template: INTERVIEW_SPRINT, anchored on a JobOpportunity.
model AgentTask {
  id              String    @id @default(uuid())
  userId          String
  title           String
  // Template key (code constants): INTERVIEW_SPRINT.
  templateKey     String
  jobOpportunityId String?
  // Reused INTERVIEW-PREP-CONTINUITY goal for the same opportunity, if one
  // exists when the task is created. Pointer only; SetNull when the goal goes.
  interviewPrepGoalId String?

  // Template-defined milestone key (derivation logic lives in card C).
  milestone       String
  // ACTIVE | PAUSED | BLOCKED | DONE | ABANDONED
  status          String    @default("ACTIVE")
  // default-FAIL checklist (JSON): [{key,label,passes,evidenceRef}].
  // Only code may flip passes; never a model.
  acceptanceItems String
  // Handoff CAS baseline: AgentTaskHandoff.revision = revision + 1 at commit.
  revision        Int       @default(0)
  // = templateKey:jobOpportunityId while ACTIVE/PAUSED/BLOCKED; NULL once
  // DONE/ABANDONED. Unique per user: one live task per template+opportunity.
  liveSlot        String?
  // Single-active-session guard (claim CAS). Plain id, not a relation: a
  // claim must survive/clear independently of the transcript row.
  activeSessionId String?
  activeSessionClaimedAt DateTime?
  // WAITING_USER_CONFIRMATION | WAITING_SCHEDULE | MISSING_FACTS | EXTERNAL_REPLY
  blockedReason   String?
  blockedInputKey String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOpportunity    JobOpportunity?   @relation(fields: [jobOpportunityId], references: [id], onDelete: SetNull)
  interviewPrepGoal InterviewPrepGoal? @relation(fields: [interviewPrepGoalId], references: [id], onDelete: SetNull)
  sessions          ChatConversation[]
  handoffs          AgentTaskHandoff[]
  events            AgentTaskEvent[]

  @@unique([userId, liveSlot])
  @@index([userId, status])
  @@index([jobOpportunityId])
}

/// Structured handoff note chain (append-only; read = highest revision).
/// Table ships with the ledger migration so card B needs no second
/// migration; the store/CAS writer is card B.
model AgentTaskHandoff {
  id        String   @id @default(uuid())
  taskId    String
  revision  Int
  state     String
  stateHash String
  sessionId String?
  generationMs Int?
  createdAt DateTime @default(now())

  task    AgentTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  session ChatConversation? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([taskId, revision])
  @@index([taskId, createdAt])
}

/// Task-level append-only event log. Pointers and short codes only.
/// Backed up (audit trail), unlike the runtime-only HarnessTaskEvent.
model AgentTaskEvent {
  id        String   @id @default(uuid())
  taskId    String
  // SESSION_START | GROUNDING | STEP | MILESTONE | BLOCKED | RESUMED |
  // HANDOFF_COMMIT | SESSION_END | STATUS | ERROR
  kind      String
  payload   String
  createdAt DateTime @default(now())

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// ---------------------------------------------------------------------------
// TODAY-PLAN per-conversation checklist (additive models only).

/// A plan row binds one Task to one conversation on one plannedOn date
/// ("YYYY-MM-DD" in the account timezone). The Task stays the single source
/// of truth for title and completion: toggling a checklist row updates the
/// shared Task, removing a row only detaches the association. plannedOn is
/// independent of Task.dueOn/dueDate — moving a row changes which date the
/// list shows it under, never the business deadline. No automatic rollover:
/// historical rows keep their date until the user or Agent moves them.
model TodayPlanItem {
  id             String   @id @default(uuid())
  userId         String
  conversationId String
  taskId         String
  plannedOn      String
  position       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // One task appears at most once per conversation — moving re-dates the
  // same row instead of duplicating it.
  @@unique([conversationId, taskId])
  @@index([userId, conversationId, plannedOn])
  @@index([userId, taskId])
}

/// Durable dedupe + undo ledger for TODAY-PLAN writes. One row per
/// operationKey (client- or tool-generated): inside the write transaction a
/// retry finds the recorded result and returns it without re-applying, so
/// repeat saves/retry/clicks cannot double-insert. undoJson is the
/// before-image consumed by conditional undo — undo only reverts rows still
/// at the recorded version and never overwrites later edits.
model TodayPlanOperation {
  id             String    @id @default(uuid())
  userId         String
  conversationId String
  operationKey   String    @unique
  // add | set | rename | toggle | reorder | move | carry_over | remove
  kind           String
  undoJson       String?
  resultJson     String?
  undoneAt       DateTime?
  createdAt      DateTime  @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, conversationId])
}
