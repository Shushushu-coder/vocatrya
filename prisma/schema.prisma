// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Step: 1 run `npx prisma generate` 
// Step: 2 run `npx prisma migrate dev` after update, make sure code is updated afterwards

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  password         String
  createdAt        DateTime           @default(now())
  jobsApplied      Job[]
  JobTitle         JobTitle[]
  Location         Location[]
  Company          Company[]
  JobSource        JobSource[]
  Contact          Contact[]
  ContactRole      ContactRole[]
  Profile          Profile[]
  Activity         Activity[]
  ActivityType     ActivityType[]
  Task             Task[]
  Automation       Automation[]
  Settings         UserSettings?
  ApiKey           ApiKey[]
  Note             Note[]
  Tag              Tag[]
  Question         Question[]
  McpAccessToken   McpAccessToken[]
  ChatConversation ChatConversation[]
  defaultResumeId  String?
  defaultResume    Resume?            @relation("UserDefaultResume", fields: [defaultResumeId], references: [id], onDelete: SetNull)

  // Vocatrya A+B foundation (additive). Cross-user relation equality is a
  // service-layer invariant and cannot be fully guaranteed by Prisma FKs alone.
  recruitmentCampaigns   RecruitmentCampaign[]
  jobOpportunities       JobOpportunity[]
  jobOpportunityNotes    JobOpportunityNote[]
  applicationAttempts    ApplicationAttempt[]
  jobSearchPreference    JobSearchPreference?
  careerMaterialItems    CareerMaterialItem[]
  candidateProfile       CandidateProfile?
  candidateSensitiveInfo CandidateSensitiveInfo?
  candidateAttachments   CandidateAttachment[]
  resumeVariants         ResumeVariant[]
  resumeImportAttempts   ResumeImportAttempt[]
  matchAnalyses          MatchAnalysis[]
  legacyMigrationMaps    LegacyMigrationMap[]
  dataMigrationRuns      DataMigrationRun[]

  // Phase 3A Interview transplant (additive backrelations only).
  interviewSessions   InterviewSession[]
  transcriptRevisions TranscriptRevision[] @relation("RevisionAuthor")

  // Phase B account-login foundation (additive backrelations only).
  aiConnections         AIConnection[]
  aiBusinessAssignments AIBusinessAssignment[]
}

/// Instance-level A+B readiness marker. Runtime enablement reads this row
/// (plus cheap integrity), never DataMigrationRun or map existence alone.
/// status=COMPLETED means Phase 3 legacy backfill finished and verified.
/// status=FRESH_READY means this instance was explicitly initialized as
/// A+B native with no legacy career/application data. Do not write COMPLETED
/// to fake a fresh instance.
model AbMigrationState {
  id           String    @id @default(uuid())
  scopeKey     String    @unique @default("instance")
  migrationKey String
  status       String    @default("NOT_STARTED")
  completedAt  DateTime?
  verifiedAt   DateTime?
  errorCode    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ApiKey {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  provider     String
  encryptedKey String
  iv           String
  last4        String
  label        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastUsedAt   DateTime?

  @@unique([userId, provider])
  @@index([userId])
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  settings  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  resumes      Resume[]
  coverLetters CoverLetter[]
}

model Resume {
  id             String          @id @default(uuid())
  profileId      String
  title          String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ContactInfo    ContactInfo?
  ResumeSections ResumeSection[]
  profile        Profile         @relation(fields: [profileId], references: [id])
  File           File?           @relation(fields: [FileId], references: [id])
  FileId         String?         @unique
  Job            Job[]
  Automation     Automation[]
  defaultForUser User[]          @relation("UserDefaultResume")
  reviewData     String?
}

model CoverLetter {
  id        String   @id @default(uuid())
  profileId String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id])
  Job       Job[]
}

model File {
  id         String   @id @default(uuid())
  fileName   String
  filePath   String
  fileType   String
  uploadedAt DateTime @default(now())
  Resume     Resume?
}

model ResumeSection {
  id                      String                   @id @default(uuid())
  resumeId                String
  sectionTitle            String
  sectionType             String
  summaryId               String?                  @unique
  summary                 Summary?                 @relation(fields: [summaryId], references: [id])
  workExperiences         WorkExperience[]
  educations              Education[]
  licenseOrCertifications LicenseOrCertification[]
  others                  OtherSection[]
  skills                  Skill[]
  Resume                  Resume                   @relation(fields: [resumeId], references: [id])
}

model ContactInfo {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resumeId  String   @unique
  firstName String
  lastName  String
  headline  String
  email     String
  phone     String
  address   String?
  url1      String?
  url1Label String?
  url2      String?
  url2Label String?
  resume    Resume   @relation(fields: [resumeId], references: [id])
}

model Summary {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  content       String
  ResumeSection ResumeSection? @relation
}

model WorkExperience {
  id              String         @id @default(uuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  companyId       String
  Company         Company        @relation(fields: [companyId], references: [id])
  jobTitleId      String
  jobTitle        JobTitle       @relation(fields: [jobTitleId], references: [id])
  startDate       DateTime
  endDate         DateTime?
  description     String
  locationId      String
  location        Location       @relation(fields: [locationId], references: [id])
  resumeSectionId String?
  ResumeSection   ResumeSection? @relation(fields: [resumeSectionId], references: [id])
}

model Education {
  id              String         @id @default(uuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  institution     String
  degree          String
  fieldOfStudy    String
  startDate       DateTime
  endDate         DateTime?
  description     String?
  locationId      String
  location        Location       @relation(fields: [locationId], references: [id])
  resumeSectionId String?
  ResumeSection   ResumeSection? @relation(fields: [resumeSectionId], references: [id])
}

model LicenseOrCertification {
  id              String         @id @default(uuid())
  title           String
  organization    String
  issueDate       DateTime?
  expirationDate  DateTime?
  credentialUrl   String?
  ResumeSection   ResumeSection? @relation(fields: [resumeSectionId], references: [id])
  resumeSectionId String?
}

model OtherSection {
  id              String         @id @default(uuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  title           String
  content         String
  ResumeSection   ResumeSection? @relation(fields: [resumeSectionId], references: [id])
  resumeSectionId String?
}

model Contact {
  id          String  @id @default(uuid())
  name        String
  title       String?
  email       String?
  phone       String?
  linkedinUrl String?

  // Where they work now
  companyId  String?
  Company    Company?  @relation("ContactCompany", fields: [companyId], references: [id])
  locationId String?
  Location   Location? @relation(fields: [locationId], references: [id])

  // Shared history — how you know them
  relationship      String?
  workedAtCompanyId String?
  WorkedAtCompany   Company?  @relation("ContactWorkedAt", fields: [workedAtCompanyId], references: [id])
  workedFrom        DateTime?
  workedTo          DateTime?

  // What this person generally is to you. The per-job role on JobContact wins
  // for a specific job; this is the standing answer and the Phase 5 prefill.
  roleId String?
  Role   ContactRole? @relation(fields: [roleId], references: [id])

  notes           String?
  lastContactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String // userId
  user      User     @relation(fields: [createdBy], references: [id])

  Interview   Interview? @relation(fields: [interviewId], references: [id])
  interviewId String?

  jobLinks JobContact[]

  @@index([createdBy])
  @@index([companyId])
  @@index([workedAtCompanyId])
  @@index([roleId])
}

model ContactRole {
  id          String       @id @default(uuid())
  label       String
  value       String
  createdBy   String // userId
  user        User         @relation(fields: [createdBy], references: [id])
  jobContacts JobContact[]
  contacts    Contact[]

  @@unique([value, createdBy])
}

model JobContact {
  id        String      @id @default(uuid())
  jobId     String
  Job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contactId String
  Contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  roleId    String
  Role      ContactRole @relation(fields: [roleId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([jobId, contactId, roleId])
  @@index([contactId])
}

model JobTitle {
  id              String           @id @default(uuid())
  label           String
  value           String
  jobs            Job[]
  createdBy       String // userId
  user            User             @relation(fields: [createdBy], references: [id])
  workExperiences WorkExperience[]

  @@unique([value, createdBy])
}

model JobStatus {
  id    String @id @default(uuid())
  label String
  value String @unique
  jobs  Job[]
}

model Location {
  id             String           @id @default(uuid())
  label          String
  value          String
  stateProv      String?
  country        String?
  jobsApplied    Job[]
  createdBy      String // userId
  user           User             @relation(fields: [createdBy], references: [id])
  educations     Education[]
  workExperience WorkExperience[]
  contacts       Contact[]

  @@unique([value, createdBy])
}

model Company {
  id              String           @id @default(uuid())
  label           String
  value           String
  jobsApplied     Job[]
  logoUrl         String? // field is optional
  createdBy       String // userId
  user            User             @relation(fields: [createdBy], references: [id])
  workExperiences WorkExperience[]

  contacts         Contact[] @relation("ContactCompany")
  formerColleagues Contact[] @relation("ContactWorkedAt")

  // Watch intent — independent of whether a board is linked
  watched   Boolean   @default(false)
  watchedAt DateTime?

  // Board coordinates; atsHost is Lever-only
  atsProvider String?
  atsToken    String?
  atsHost     String?

  // Company attributes, unrelated to boards
  websiteUrl String?
  careersUrl String?
  industry   String?

  // Optional A+B attributes; existing Job / WorkExperience / Contact / ATS
  // relations are unchanged.
  notes        String?
  sizeLabel    String?
  headquarters String?

  recruitmentCampaigns    RecruitmentCampaign[]
  jobOpportunities        JobOpportunity[]
  careerInternshipDetails CareerInternshipDetail[]
  careerEmploymentDetails CareerEmploymentDetail[]

  @@unique([value, createdBy])
  @@unique([createdBy, atsProvider, atsToken])
  @@index([createdBy, watched])
}

model JobSource {
  id          String @id @default(uuid())
  label       String
  value       String
  jobsApplied Job[]
  createdBy   String // userId
  user        User   @relation(fields: [createdBy], references: [id])

  @@unique([value, createdBy])
}

model Interview {
  id           String    @id @default(uuid())
  createdAt    DateTime
  jobId        String
  job          Job?      @relation(fields: [jobId], references: [id])
  interviewers Contact[]
}

model Job {
  id            String       @id @default(uuid())
  userId        String
  User          User         @relation(fields: [userId], references: [id])
  jobUrl        String?
  description   String
  jobType       String
  workplaceType String?
  createdAt     DateTime
  applied       Boolean      @default(false)
  appliedDate   DateTime?
  dueDate       DateTime?
  statusId      String
  Status        JobStatus    @relation(fields: [statusId], references: [id])
  JobTitle      JobTitle     @relation(fields: [jobTitleId], references: [id])
  jobTitleId    String
  Company       Company      @relation(fields: [companyId], references: [id])
  companyId     String
  JobSource     JobSource?   @relation(fields: [jobSourceId], references: [id])
  jobSourceId   String?
  salaryRange   String?
  Location      Location?    @relation(fields: [locationId], references: [id])
  locationId    String?
  Interview     Interview[]
  Resume        Resume?      @relation(fields: [resumeId], references: [id])
  resumeId      String?
  CoverLetter   CoverLetter? @relation(fields: [coverLetterId], references: [id])
  coverLetterId String?
  Notes         Note[]
  tags          Tag[]
  contactLinks  JobContact[]

  // Automation discovery fields
  automationId    String?
  automation      Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  matchScore      Int?
  matchData       String?
  discoveryStatus String?
  discoveredAt    DateTime?

  // MCP provenance: which agent/token created this job (null = UI or automation)
  createdVia              String?
  // Word-count classification of `description` at write time:
  // "title-only" | "partial" | "full". Null for pre-existing/UI jobs.
  descriptionCompleteness String?
  // Also has a hand-written partial unique index (not expressible here):
  // UNIQUE(userId, jobUrl) WHERE automationId IS NOT NULL
  // See migrations/20260710000002_job_automation_url_unique

  @@index([userId, automationId])
  @@index([userId, discoveryStatus])
}

model ActivityType {
  id          String   @id @default(uuid())
  label       String
  value       String
  description String?
  createdBy   String // userId
  user        User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Activities Activity[]
  Tasks      Task[]

  @@unique([value, createdBy])
}

model Activity {
  id               String    @id @default(uuid())
  userId           String
  User             User      @relation(fields: [userId], references: [id])
  activityName     String
  startTime        DateTime
  endTime          DateTime?
  duration         Int?
  // Completed break time in minutes. Existing rows default to 0, so
  // duration keeps meaning (endTime - startTime) for everything already saved.
  breakMinutes     Int       @default(0)
  // Set only while a break is open — this is the on-break flag.
  breakStartedAt   DateTime?
  // Drives the countdown ring only; never the arithmetic.
  breakPlannedMins Int?
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activityType   ActivityType @relation(fields: [activityTypeId], references: [id])
  activityTypeId String

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])
}

model Task {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  title           String
  description     String?
  status          String    @default("in-progress")
  priority        Int       @default(5)
  percentComplete Int       @default(0)
  dueDate         DateTime?
  dueOn           String?
  duePrecision    String?

  activityTypeId String?
  activityType   ActivityType? @relation(fields: [activityTypeId], references: [id])

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, activityTypeId])
  @@index([userId, dueDate])
}

model Automation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name           String
  jobBoard       String
  keywords       String
  location       String
  sourceConfig   String? // JSON; per-source params (Greenhouse watchlist, titles)
  resumeId       String
  resume         Resume  @relation(fields: [resumeId], references: [id])
  matchThreshold Int     @default(80)

  scheduleHour Int
  nextRunAt    DateTime?
  lastRunAt    DateTime?

  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs                    AutomationRun[]
  discoveredJobs          Job[]
  discoveredOpportunities JobOpportunity[]

  @@index([userId])
  @@index([status, nextRunAt])
}

model AutomationRun {
  id           String     @id @default(uuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  jobsSearched     Int @default(0)
  jobsDeduplicated Int @default(0)
  jobsProcessed    Int @default(0)
  jobsMatched      Int @default(0)
  jobsSaved        Int @default(0)

  status        String  @default("running")
  errorMessage  String?
  blockedReason String?
  funnelStats   String? // JSON: ordered per-source funnel for the run summary

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  // Also has a hand-written partial unique index (not expressible here):
  // UNIQUE(automationId) WHERE status IN ('running', 'cancelling')
  // See migrations/20260710000001_automation_run_single_active

  // Phase B: nullable AI lock captured at resolution time. NO_GUESS_BACKFILL:
  // existing rows keep NULL and rely on provider/model provenance alone.
  // Immutable historical snapshot; never hosted entitlement authority.
  managedAiProvenance String?
  resolvedConnectionId String?
  resolvedModel        String?
  resolvedConnection   AIConnection? @relation(fields: [resolvedConnectionId], references: [id], onDelete: Restrict)

  @@index([automationId])
  @@index([startedAt])
}

model Note {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([userId])
}

model Tag {
  id                 String              @id @default(uuid())
  label              String
  value              String
  createdBy          String
  user               User                @relation(fields: [createdBy], references: [id])
  jobs               Job[]
  questions          Question[]
  skills             Skill[]
  careerSkillDetails CareerSkillDetail[]

  @@unique([value, createdBy])
}

model Skill {
  id              String        @id @default(uuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  category        String?
  order           Int           @default(0)
  tagId           String
  Tag             Tag           @relation(fields: [tagId], references: [id])
  resumeSectionId String
  ResumeSection   ResumeSection @relation(fields: [resumeSectionId], references: [id])

  @@index([resumeSectionId])
}

model Question {
  id         String   @id @default(uuid())
  question   String
  answer     String?
  createdBy  String
  user       User     @relation(fields: [createdBy], references: [id])
  tags       Tag[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdVia String? // MCP provenance: which agent/token created this, mirrors Job.createdVia

  // Phase 3A Interview additive metadata (port canonical naming:
  // presetBankKey/presetItemKey, see PORT port contract). Existing rows
  // keep NULL/defaults; no backfill. onDelete on `user` intentionally
  // unchanged to keep migration additive (ALTER TABLE ADD COLUMN only).
  sourceKind    String?
  category      String?
  locale        String?   @default("zh")
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  presetBankKey String?
  presetItemKey String?

  questionInstances QuestionInstance[]
  bankItems         QuestionBankItem[]

  @@unique([presetBankKey, presetItemKey])
  @@index([createdBy])
}

model McpAccessToken {
  id          String    @id @default(uuid())
  userId      String
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scopes      String // JSON array string; new tokens are always ["jobs:write","questions:write","resume:write"]
  expiresAt   DateTime
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model ChatConversation {
  revision               Int                  @default(0)
  activeRequestId        String?
  activeRequestExpiresAt DateTime?
  id                     String               @id @default(uuid())
  userId                 String
  // Deterministic display title. Null on rows migrated from the single
  // conversation model — History derives a fallback and does not backfill.
  title                  String?
  // JSON AgentConversationContextV1. Null on historical rows means "no
  // stored context", not "guess the page the user was on".
  context                String?
  messages               String // JSON-serialized UIMessage[]
  // Career Dialogue creation-time AI lock. Captured once when the row is
  // created, never rewritten afterwards:
  // - resolvedConnectionId set -> the conversation runs the locked
  //   AIConnection + model on the account runtime.
  // - both null -> legacy settings.ai provider/model semantics (historical
  //   rows and conversations created while nothing is configured).
  // Deliberately NOT a relation: a restored backup may reference a
  // connection that does not exist locally, and that orphaned lock must
  // surface as an explicit error rather than be silently nulled.
  // Immutable historical snapshot; never hosted entitlement authority.
  managedAiProvenance String?
  resolvedConnectionId   String?
  resolvedModel          String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Disposable transcript-compression cache. Deleting the row never
  // removes career facts. Cascade follows the conversation.
  conversationSummary    ConversationSummary?

  @@index([userId, updatedAt])
}

/// 1:1 transcript compression cache for Career Dialogue.
/// Not a career-fact store. No backfill: a missing row means P2 behavior.
model ConversationSummary {
  conversationId   String    @id
  userId           String
  text             String?
  throughMessageId String?
  coverageHash     String?
  coveredCount     Int?
  promptVersion    String?
  revision         Int       @default(0)
  units            Int?
  generationMs     Int?
  generatedAt      DateTime?
  failureCount     Int       @default(0)
  lastFailureAt    DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Vocatrya A+B foundation — additive models only.
// Legacy Job / Resume / Company / Automation tables are unchanged.
// Status/type codes stay String; evolving payloads stay serialized JSON String.
// Cross-user relation equality is a service-layer invariant and cannot be
// fully guaranteed by Prisma foreign keys alone.
// ---------------------------------------------------------------------------

model RecruitmentCampaign {
  id        String @id @default(uuid())
  userId    String
  companyId String

  name            String
  recruitmentType String?
  year            Int?
  season          String?

  startDate  DateTime?
  endDate    DateTime?
  careersUrl String?

  status     String    @default("UNKNOWN")
  notes      String?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunities JobOpportunity[]

  @@index([userId, archivedAt])
  @@index([companyId, year])
}

/// Opportunity describes the posting, not the user's process.
/// Status is ACTIVE / CLOSED / EXPIRED / UNKNOWN — never Interview / Rejected / Offer.
model JobOpportunity {
  id         String  @id @default(uuid())
  userId     String
  companyId  String
  campaignId String?

  title           String
  normalizedTitle String?

  locationText    String?
  employmentType  String?
  recruitmentType String?
  workplaceType   String?

  sourceSystem      String?
  sourceLabel       String?
  sourceUrl         String?
  externalSourceKey String?

  deadline          DateTime?
  deadlineOn        String?
  deadlinePrecision String?
  recruitmentCohort String?
  recruitmentBatch  String?
  salaryText        String?

  status String @default("UNKNOWN")

  currentJdVersionId String?   @unique
  sourceAutomationId String?
  discoveredAt       DateTime?
  closedAt           DateTime?

  notes      String?
  archivedAt DateTime?
  createdVia String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  campaign         RecruitmentCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  currentJdVersion JobDescriptionVersion? @relation("OpportunityCurrentJd", fields: [currentJdVersionId], references: [id], onDelete: SetNull)
  sourceAutomation Automation?            @relation(fields: [sourceAutomationId], references: [id], onDelete: SetNull)

  descriptionVersions    JobDescriptionVersion[] @relation("OpportunityJdVersions")
  applicationAttempts    ApplicationAttempt[]
  opportunityNotes       JobOpportunityNote[]
  matchAnalyses          MatchAnalysis[]
  targetedResumeVariants ResumeVariant[]

  // Phase 3A Interview transplant (additive backrelation only).
  interviewSessions InterviewSession[]

  @@index([userId, status])
  @@index([userId, deadline])
  @@index([companyId, campaignId])
  @@index([companyId, normalizedTitle])
}

model JobOpportunityNote {
  id               String   @id @default(uuid())
  userId           String
  jobOpportunityId String
  content          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  jobOpportunity JobOpportunity @relation(fields: [jobOpportunityId], references: [id], onDelete: Cascade)

  @@index([jobOpportunityId])
  @@index([userId])
}

/// Immutable by application convention: never update rawContent after create.
/// Same contentHash on the same opportunity must not create another version.
model JobDescriptionVersion {
  id               String @id @default(uuid())
  jobOpportunityId String

  versionNumber    Int
  rawContent       String
  rawContentFormat String   @default("PLAIN_TEXT")
  sourceUrl        String?
  capturedAt       DateTime
  contentHash      String
  currentParseId   String?  @unique
  createdVia       String?
  createdAt        DateTime @default(now())

  jobOpportunity         JobOpportunity         @relation("OpportunityJdVersions", fields: [jobOpportunityId], references: [id], onDelete: Restrict)
  currentForOpportunity  JobOpportunity?        @relation("OpportunityCurrentJd")
  currentParse           JobDescriptionParse?   @relation("JdVersionCurrentParse", fields: [currentParseId], references: [id], onDelete: SetNull)
  parses                 JobDescriptionParse[]  @relation("JdVersionParses")
  submittedAttempts      ApplicationAttempt[]   @relation("AttemptSubmittedAgainstJd")
  targetedResumeVersions ResumeVariantVersion[] @relation("ResumeVersionTargetJd")

  // Phase 3A Interview transplant (additive backrelation only).
  interviewSessions InterviewSession[]

  @@unique([jobOpportunityId, versionNumber])
  @@unique([jobOpportunityId, contentHash])
  // Phase 3A: composite-FK support for
  // InterviewSession.(jobDescriptionVersionId, jobOpportunityId).
  // Logically redundant for uniqueness, required for Prisma composite FK.
  // Additive unique index only; no JD business semantics change.
  @@unique([id, jobOpportunityId])
}

model JobDescriptionParse {
  id                      String @id @default(uuid())
  jobDescriptionVersionId String

  schemaVersion  String
  parserVersion  String
  structuredData String
  parseStatus    String
  provider       String?
  model          String?
  promptVersion  String?
  inputHash      String
  errorCode      String?
  parsedAt       DateTime?
  createdAt      DateTime  @default(now())

  // Phase B: nullable AI connection lock. `model` above already carries the
  // resolved model provenance, so no resolvedModel synonym is added here.
  // Immutable historical snapshot; never hosted entitlement authority.
  managedAiProvenance String?
  resolvedConnectionId String?
  resolvedConnection   AIConnection? @relation(fields: [resolvedConnectionId], references: [id], onDelete: Restrict)

  jobDescriptionVersion JobDescriptionVersion  @relation("JdVersionParses", fields: [jobDescriptionVersionId], references: [id], onDelete: Restrict)
  currentForVersion     JobDescriptionVersion? @relation("JdVersionCurrentParse")
  matchAnalyses         MatchAnalysis[]

  @@index([jobDescriptionVersionId])
}

model ApplicationAttempt {
  id               String @id @default(uuid())
  userId           String
  jobOpportunityId String

  channelCategory String?
  channelLabel    String
  sourceUrl       String?

  submittedAt          DateTime?
  currentStageCategory String    @default("DRAFT")
  outcome              String    @default("ACTIVE")

  transferredFromAttemptId String?

  submittedResumeVersionId    String?
  submittedResumeArtifactId   String?
  submittedAgainstJdVersionId String?

  notes      String?
  createdVia String?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                      User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  jobOpportunity            JobOpportunity           @relation(fields: [jobOpportunityId], references: [id], onDelete: Restrict)
  transferredFromAttempt    ApplicationAttempt?      @relation("AttemptTransferredFrom", fields: [transferredFromAttemptId], references: [id], onDelete: SetNull)
  transferredToAttempts     ApplicationAttempt[]     @relation("AttemptTransferredFrom")
  submittedResumeVersion    ResumeVariantVersion?    @relation("AttemptSubmittedResumeVersion", fields: [submittedResumeVersionId], references: [id], onDelete: Restrict)
  submittedResumeArtifact   ResumeArtifact?          @relation("AttemptSubmittedResumeArtifact", fields: [submittedResumeArtifactId], references: [id], onDelete: Restrict)
  submittedAgainstJdVersion JobDescriptionVersion?   @relation("AttemptSubmittedAgainstJd", fields: [submittedAgainstJdVersionId], references: [id], onDelete: Restrict)
  processSteps              ApplicationProcessStep[]

  @@index([userId, currentStageCategory])
  @@index([userId, outcome])
  @@index([jobOpportunityId, createdAt])
  @@index([transferredFromAttemptId])
}

model ApplicationProcessStep {
  id                   String @id @default(uuid())
  applicationAttemptId String

  category    String
  label       String
  status      String    @default("PENDING")
  sortOrder   Int
  scheduledAt          DateTime?
  scheduledAtPrecision String?
  scheduledAtZone      String?
  deadlineAt           DateTime?
  deadlineOn           String?
  deadlinePrecision    String?
  deadlineZone         String?
  completedAt          DateTime?
  completedAtPrecision String?
  result      String?
  source      String    @default("USER")
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationAttempt ApplicationAttempt           @relation(fields: [applicationAttemptId], references: [id], onDelete: Cascade)
  interviewDetail    ApplicationInterviewDetail?
  assessmentDetail   ApplicationAssessmentDetail?
  offerDetail        ApplicationOfferDetail?

  @@index([applicationAttemptId, sortOrder])
  @@index([scheduledAt])
}

/// Interview-specific root hanging off ApplicationProcessStep (optional 1:1).
/// Domain invariant (service-layer; Prisma cannot enforce it): parent
/// ProcessStep.category must be INTERVIEW.
/// Timeline / Upcoming facts stay on ProcessStep (label, status, scheduledAt,
/// deadlineAt, completedAt, result, notes, source, sortOrder).
/// roundLabel is retained but is NOT the round source of truth.
/// structuredData is retained but is NOT the interview reflection store.
/// Metadata columns are additive-only and are not productized in this phase.
model ApplicationInterviewDetail {
  id                       String   @id @default(uuid())
  applicationProcessStepId String   @unique
  interviewFormat          String?
  roundLabel               String?
  locationText             String?
  interviewerNames         String?
  durationMinutes          Int?
  structuredData           String   @default("{}")
  /// Whole-interview free-text reflection. Not a per-question note.
  reflectionText           String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  processStep     ApplicationProcessStep               @relation(fields: [applicationProcessStepId], references: [id], onDelete: Cascade)
  reflectionItems ApplicationInterviewReflectionItem[]
}

/// Ordered question + answer-notes child of ApplicationInterviewDetail.
/// Belongs to an INTERVIEW step only through the parent detail.
/// sortOrder is a stable ordering key; duplicates are allowed so reorder
/// can be implemented without a unique constraint. New items should follow
/// the 10/20/30 increment convention used by ApplicationProcessStep.
model ApplicationInterviewReflectionItem {
  id                           String   @id @default(uuid())
  applicationInterviewDetailId String
  questionText                 String
  answerNotes                  String?
  sortOrder                    Int
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  applicationInterviewDetail ApplicationInterviewDetail @relation(fields: [applicationInterviewDetailId], references: [id], onDelete: Cascade)

  @@index([applicationInterviewDetailId, sortOrder])
}

