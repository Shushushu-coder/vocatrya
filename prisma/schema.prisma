/// Durable pre-invocation identity for the canonical resume import (M4).
/// The client mints `id` before the first POST and reuses it on transport
/// retries, so the same logical import always resolves to the same
/// attempt — and therefore the same Managed binding + operation identity.
/// state: PENDING (created) → RUNNING (lock persisted) → EXECUTED
/// (resultJson cached) | FAILED (execution failed; executionSeq bumped so
/// a later retry is a genuinely new operation) → CONFIRMED.
/// requestSha is a consistency guard only — never an operation key.
model ResumeImportAttempt {
  id     String @id
  userId String

  state        String @default("PENDING")
  executionSeq Int    @default(0)
  requestSha   String

  resolvedConnectionId String?
  resolvedModel        String?
  managedAiProvenance  String?

  /// Cached structured result — replayed to post-crash retries because
  /// the Hosted invocation ledger returns receipts, not payloads.
  resultJson String?

  /// First successful confirm selection; NULL on pre-feature rows.
  confirmedSelectionSha String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// FAST_SCREENING requires resumeVariantVersionId = null;
/// DEEP_MATCH requires resumeVariantVersionId != null.
/// Enforced in the service layer, not by the database.
model MatchAnalysis {
  id                    String @id @default(uuid())
  userId                String
  jobOpportunityId      String
  jobDescriptionParseId String

  analysisType           String
  resumeVariantVersionId String?

  inputHash             String
  analysisSchemaVersion String
  provider              String?
  model                 String?
  promptVersion         String?
  status                String
  errorCode             String?
  isStale               Boolean   @default(false)
  staleReasonCodes      String?
  staleAt               DateTime?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Phase B: nullable AI connection lock. `model` above already carries the
  // resolved model provenance, so no resolvedModel synonym is added here.
  // Immutable historical snapshot; never hosted entitlement authority.
  managedAiProvenance String?
  resolvedConnectionId String?
  resolvedConnection   AIConnection? @relation(fields: [resolvedConnectionId], references: [id], onDelete: Restrict)

  user                    User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  jobOpportunity          JobOpportunity         @relation(fields: [jobOpportunityId], references: [id], onDelete: Restrict)
  jobDescriptionParse     JobDescriptionParse    @relation(fields: [jobDescriptionParseId], references: [id], onDelete: Restrict)
  resumeVariantVersion    ResumeVariantVersion?  @relation("MatchAnalysisResumeVersion", fields: [resumeVariantVersionId], references: [id], onDelete: Restrict)
  resumeVersionsFromMatch ResumeVariantVersion[] @relation("ResumeVersionSourceMatch")
  fastScreeningDetail     FastScreeningDetail?
  deepMatchDetail         DeepMatchDetail?
  evidenceLinks           MatchEvidenceLink[]
  // The durable Agent execution this analysis completed, when it was
  // produced by match_job. Unique on the execution side — one analysis can
  // settle at most one execution.
  agentToolExecution      AgentToolExecution?
  // The harness task this analysis is bound to, when produced by the
  // DEEP_MATCH consumer. Unique on the task side — one task commits at
  // most one analysis.
  harnessTaskResult     HarnessTask?      @relation("HarnessTaskResult")

  @@index([jobOpportunityId, analysisType, isStale])
  @@index([userId, analysisType, isStale])
  @@index([resumeVariantVersionId])
}

model FastScreeningDetail {
  id               String   @id @default(uuid())
  matchAnalysisId  String   @unique
  verdict          String
  inputSnapshot    String
  hardRequirements String?
  coreMatch        String?
  preferenceMatch  String?
  reasons          String?
  createdAt        DateTime @default(now())

  matchAnalysis MatchAnalysis @relation(fields: [matchAnalysisId], references: [id], onDelete: Cascade)
}

/// Durable Agent tool-execution reservation (match_job). Created on the
/// first approved execute of a persisted turn: the dedupe identity is the
/// originating user-message id, never the client requestId or the model's
/// toolCallId. `operationKey` is the server-minted stable business operation
/// identity that Managed replay and crash recovery reuse. A PENDING row on
/// the same turn resumes under the same operationKey; a PENDING row whose
/// turn was superseded is swept to ABORTED by the next acquire and is never
/// resumed — a dead turn cannot come back.
///
/// matchAnalysisId is the database-level unique binding that closes the
/// "model finished but the receipt/result never landed" window: completing
/// the execution and persisting the analysis commit atomically, so a retry
/// replays instead of writing a second analysis row. SetNull on analysis
/// delete keeps restore wipes honest without resurrecting the link.
model AgentToolExecution {
  id              String   @id @default(uuid())
  userId          String
  conversationId  String
  toolName        String
  // Originating persisted user-message id — the turn identity. Together
  // with (conversationId, toolName) it is the execution's dedupe key: a new
  // explicit user turn mints a new execution while every retry of the same
  // turn lands on this row.
  turnKey         String
  // Canonical hash of the validated tool input — the same turn re-proposing
  // a different input is a turn conflict, never a second execution.
  inputHash       String
  operationKey    String   @unique
  // PENDING — live reservation; COMPLETED — analysis linked; FAILED —
  // terminal non-analysis outcome recorded in resultJson; ABORTED —
  // superseded turn swept by a later acquire.
  status          String   @default("PENDING")
  matchAnalysisId String?  @unique
  failureCode     String?
  // Serialized tool result for terminal outcomes. A COMPLETED row missing
  // it sits in the crash window between the analysis+link commit and this
  // write — replay rebuilds the result from the analysis row.
  resultJson      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation  ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  matchAnalysis MatchAnalysis?   @relation(fields: [matchAnalysisId], references: [id], onDelete: SetNull)

  @@unique([conversationId, toolName, turnKey])
  @@index([userId, status])
}

/// Persistent user-facing operation proposal (durable approval). Backed up:
/// unlike the transcript approval part (display) and the HarnessTask
/// (runtime ledger), this row is the business-level authority for "what was
/// proposed, decided and dispatched". conversationId is SetNull on source
/// delete so decision/dispatch evidence survives its transcript.
/// Statuses: PROPOSED | APPROVED | REJECTED | WITHDRAWN | SUPERSEDED |
/// EXPIRED. Execution evidence lives in dispatchedAt/outcomeStatus/
/// outcomeJson — APPROVED is an intent, never a success claim.
model AgentOperationProposal {
  id              String   @id @default(uuid())
  userId          String
  // Nullable + SetNull per the hard-delete contract: deleting the source
  // conversation keeps the evidence, it never re-arms the operation.
  conversationId  String?
  messageId       String?
  toolCallId      String   @unique
  approvalId      String   @unique
  turnKey         String
  toolName        String
  // Server-validated immutable input + canonical dedupe hash. The decision
  // binds exactly this input version — an input change is a new proposal.
  inputJson       String
  inputHash       String
  // Target/connection snapshot pinned at proposal time (JSON):
  // {workspaceId?} — VERIFY fails instead of silently swapping workspace.
  materialJson    String?
  status          String   @default("PROPOSED")
  revision        Int      @default(0)
  decidedAt       DateTime?
  decisionReason  String?
  expiresAt       DateTime
  // Runtime task pointer — cleared on backup restore; HarnessTask is never
  // backed up, and a stale task id must never impersonate a live execution.
  harnessTaskId   String?  @unique
  // Dispatch intent + stable operation identity. Written inside the
  // pre-remote-call transaction, backed up: "may already be out" is
  // evidence, not a success receipt.
  dispatchKey     String?  @unique
  dispatchedAt    DateTime?
  // Terminal outcome mirror: SUCCEEDED | FAILED | UNCERTAIN | CANCELLED.
  outcomeStatus   String?
  outcomeJson     String?
  // User-attested resolution of an UNCERTAIN outcome — evidence of the
  // manual check, never a fabricated remote receipt.
  manualResolution String?
  resolvedAt      DateTime?
  // History link for re-proposals: the new row points at the one it
  // supersedes. Plain column (remapped by the backup idmap), no FK.
  supersedesId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([userId, toolName, inputHash])
}

/// Durable long-running task row (harness). First consumer: DEEP_MATCH.
/// Runtime recovery ledger, not user state: excluded from the product
/// backup like AgentToolExecution — settled artifacts live in
/// MatchAnalysis (backed up), and restoring task rows would resurrect
/// leases whose executor no longer exists.
///
/// Ownership model: a task is QUEUED, RUNNING under one claimed epoch, or
/// CANCELLING; SUCCEEDED/FAILED/CANCELLED are terminal and immutable.
/// Every successful claim increments claimEpoch and stamps
/// (leaseOwner, leaseUntil) via a conditional update — a superseded
/// runner's ownership-checked writes can never commit.
model HarnessTask {
  id     String @id @default(uuid())
  userId String
  kind   String
  status String @default("QUEUED")

  // Stable create-request dedupe identity: the client mints one requestKey
  // per user intent, a retransmitted create lands on this row, and a new
  // explicit run mints a new task.
  requestKey String
  // Canonical hash of the validated create input. A same-requestKey
  // retransmission carrying a different input is a conflict, never a
  // second task.
  inputHash String
  // Frozen task input (JSON): pinned job/JD-version/resume-version ids
  // plus the input schema version. Recovery never re-reads "latest"
  // business objects.
  inputJson String
  // Pinned execution input written by the PIN_INPUTS checkpoint (JSON):
  // resolved connection/model/parse ids, content hashes, prompt/schema
  // versions and the exact material text the model call uses — a
  // recovered epoch never silently re-resolves the assignment or swaps
  // in newer material.
  pinnedJson String?
  currentStep String?
  // Denormalized lookup key for the job-detail surface (mirrors
  // inputJson.jobOpportunityId; intentionally no FK — the ledger must
  // never block business deletes, and the runner re-verifies ownership
  // at execution time). Null for non-job kinds (AGENT_TOOL_WRITE).
  jobOpportunityId String?

  // Execution ownership: incremented on every successful claim; carried
  // by every ownership-checked write. leaseUntil is renewed while the
  // holder runs; expiry lets a later claim reclaim the task.
  claimEpoch      Int       @default(0)
  leaseOwner      String?
  leaseUntil      DateTime?
  startedAt       DateTime?
  lastHeartbeatAt DateTime?

  attemptCount      Int       @default(0)
  cancelRequestedAt DateTime?

  failureCode      String?
  failureDetail    String?
  // The analysis this task committed; unique — one analysis settles at
  // most one task.
  resultAnalysisId String?  @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultAnalysis MatchAnalysis?     @relation("HarnessTaskResult", fields: [resultAnalysisId], references: [id], onDelete: SetNull)
  events         HarnessTaskEvent[]

  @@unique([userId, kind, requestKey])
  @@index([status, leaseUntil])
  @@index([userId, kind, status])
  @@index([userId, jobOpportunityId])
}

/// Append-only harness task trace: enough to locate and correlate —
/// claim/step/checkpoint/model-call/cancel/terminal records carrying
/// ids, codes, durations, versions and content hashes. Never secrets or
/// raw materials, not a replayable record of what the model saw, and not
/// the state authority (the HarnessTask row is).
model HarnessTaskEvent {
  id     String @id @default(uuid())
  taskId String
  // Claim epoch that emitted the event — 0 for pre-claim writes.
  epoch  Int
  // Per-task monotonic sequence for ordering. Not a business idempotency
  // mechanism — side-effect steps carry their own operation identity.
  seq    Int
  type   String
  // Small structured payload: ids, codes, durations, hashes, versions.
  payloadJson String?
  createdAt   DateTime @default(now())

  task HarnessTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, seq])
  @@index([taskId, type])
}

/// EXT-NOTION: one Notion MCP connection per user. OAuth client registration
/// ids and workspace metadata are stored in plain columns; the access/refresh
/// token bundle and the in-flight OAuth flow are sealed by the credential
/// store (same envelope as BYOK keys: safeStorage on desktop, app cipher on
/// web). Never returned to the renderer, never logged, excluded from backup.
model NotionConnection {
  id                  String   @id @default(uuid())
  userId              String   @unique
  status              String   @default("DISCONNECTED")
  workspaceId         String?
  workspaceName       String?
  workspaceIcon       String?
  notionUserId        String?
  botId               String?
  grantedScope        String?
  // Dynamically-registered OAuth client id (not secret). A client_secret,
  // when Notion issues one, lives inside the sealed credential bundle.
  oauthClientId       String?
  // Remote tool names from the last successful tools/list (JSON array).
  availableTools      String?
  // Sealed token bundle: {accessToken, refreshToken?, expiresAt?, clientSecret?}.
  encryptedCredential String?
  credentialIv        String?
  // Sealed in-flight OAuth flow: {state, codeVerifier, redirectUri, appOrigin, expiresAt}.
  pendingCipher       String?
  pendingIv           String?
  // sha256 hex of the pending state, so the loopback callback can look the
  // flow up without unsealing every row.
  pendingStateHash    String?
  lastVerifiedAt      DateTime?
  lastUsedAt          DateTime?
  connectedAt         DateTime?
  lastError           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pendingStateHash])
}

/// EXT-FEISHU Feishu self-built app connection. Application identity only
/// (tenant_access_token) — no user OAuth, no pending flow. The App Secret
/// lives inside the sealed credential bundle; appId is an identifier, kept
/// readable so proposals can bind the connection they were approved against.
model FeishuConnection {
  id                   String   @id @default(uuid())
  userId               String   @unique
  revision             Int      @default(0)
  status               String   @default("DISCONNECTED")
  appId                String?
  // Capability keys probed against the live API at connect/verify time
  // (JSON array, e.g. ["drive.list","wiki.read","docx.read","docx.write"]).
  // These are scopes the app has been granted, not proof every document is
  // reachable — resource access stays per-document.
  availableCapabilities String?
  // Sealed credential bundle: {v, appId, appSecret, tenantAccessToken?}.
  encryptedCredential  String?
  credentialIv         String?
  lastVerifiedAt       DateTime?
  lastUsedAt           DateTime?
  connectedAt          DateTime?
  lastError            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One-shot browser-extension pairing grant for EXT-AUTO-APPLY. The user
/// creates a short-lived pairing code in the app; the plugin exchanges it
/// once for a long-lived connection token. Only the sha256 of the secret is
/// stored — the plaintext code never persists.
model AutoApplyExtensionPairing {
  id              String    @id @default(uuid())
  userId          String
  secretHash      String    @unique
  // JSON array of AutoApplySectionKey granted at pair time.
  allowedSections String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// EXT-AUTO-APPLY paired plugin instance. `tokenHash` is the sha256 of the
/// bearer token the plugin presents — plaintext tokens are never stored.
/// revokedAt set means the token is dead even if still presented.
model AutoApplyExtensionConnection {
  id              String    @id @default(uuid())
  userId          String
  clientName      String?
  tokenHash       String    @unique
  // JSON array of AutoApplySectionKey the plugin may pull.
  allowedSections String
  pairedAt        DateTime  @default(now())
  lastSeenAt      DateTime?
  lastSyncAt      DateTime?
  // profileV2.updatedAt of the last payload this connection pulled.
  lastProfileUpdatedAt String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeepMatchDetail {
