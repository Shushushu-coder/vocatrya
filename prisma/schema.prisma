  versions             ResumeVariantVersion[] @relation("ResumeVariantVersions")

  @@index([userId, archivedAt])
}

/// DRAFT is mutable; FROZEN / SUBMITTED / ARCHIVED immutability is enforced
/// in the service layer, not by database triggers.
model ResumeVariantVersion {
  id              String @id @default(uuid())
  resumeVariantId String

  versionNumber         Int
  parentVersionId       String?
  status                String    @default("DRAFT")
  targetJdVersionId     String?
  sourceMatchAnalysisId String?
  locale                String?
  headerSnapshot        String?
  layoutConfig          String?
  createdVia            String    @default("USER")
  createdAt             DateTime  @default(now())
  frozenAt              DateTime?

  // Phase B: nullable AI lock captured at resolution time. NO_GUESS_BACKFILL.
  // Immutable historical snapshot; never hosted entitlement authority.
  managedAiProvenance String?
  resolvedConnectionId String?
  resolvedModel        String?
  resolvedConnection   AIConnection? @relation(fields: [resolvedConnectionId], references: [id], onDelete: Restrict)

  resumeVariant       ResumeVariant          @relation("ResumeVariantVersions", fields: [resumeVariantId], references: [id], onDelete: Restrict)
  currentForVariant   ResumeVariant?         @relation("ResumeVariantCurrentVersion")
  parentVersion       ResumeVariantVersion?  @relation("ResumeVersionParent", fields: [parentVersionId], references: [id], onDelete: Restrict)
  childVersions       ResumeVariantVersion[] @relation("ResumeVersionParent")
  targetJdVersion     JobDescriptionVersion? @relation("ResumeVersionTargetJd", fields: [targetJdVersionId], references: [id], onDelete: Restrict)
  sourceMatchAnalysis MatchAnalysis?         @relation("ResumeVersionSourceMatch", fields: [sourceMatchAnalysisId], references: [id], onDelete: SetNull)
  sections            ResumeVariantSection[]
  artifacts           ResumeArtifact[]
  submittedAttempts   ApplicationAttempt[]   @relation("AttemptSubmittedResumeVersion")
  deepMatchAnalyses   MatchAnalysis[]        @relation("MatchAnalysisResumeVersion")

  @@unique([resumeVariantId, versionNumber])
}

