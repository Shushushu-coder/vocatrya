/// storageKey is a relative/logical key, never a fixed Windows absolute path.
model ResumeArtifact {
  id                     String @id @default(uuid())
  resumeVariantVersionId String

  kind       String
  format     String
  storageKey String
  fileName   String
  sha256     String
  byteSize   Int?

  createdAt DateTime @default(now())

  version           ResumeVariantVersion @relation(fields: [resumeVariantVersionId], references: [id], onDelete: Cascade)
  submittedAttempts ApplicationAttempt[] @relation("AttemptSubmittedResumeArtifact")

  @@index([resumeVariantVersionId])
